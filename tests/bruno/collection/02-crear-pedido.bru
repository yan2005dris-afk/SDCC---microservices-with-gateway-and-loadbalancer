meta {
  name: 02 - Crear Pedido Exitoso (P04 y P05)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerName": "Yandris Rivera",
    "customerEmail": "yan.2005dris@gmail.com",
    "productCode": "PROD-001",
    "quantity": 2,
    "unitPrice": 1899.99
  }
}

assert {
  res.status: eq 201
  res.headers["x-database-node"]: eq PRIMARY
  res.body.status: eq CONFIRMED
}
