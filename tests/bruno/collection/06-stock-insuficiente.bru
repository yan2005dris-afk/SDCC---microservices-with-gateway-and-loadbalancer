meta {
  name: 06 - Rechazar Pedido sin Stock (P04)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: sdcc-bruno-reject
}

body:json {
  {
    "customerName": "Cliente Demo Sin Stock",
    "customerEmail": "sin-stock@example.invalid",
    "productCode": "PROD-001",
    "quantity": 9999
  }
}

assert {
  res.status: eq 400
}