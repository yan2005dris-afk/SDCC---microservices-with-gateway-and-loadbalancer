meta {
  name: 04 - Lectura Critica Inmediata (P07)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/orders/{{orderId}}
  body: none
  auth: none
}

headers {
  X-Consistency: critical
  X-Correlation-Id: sdcc-bruno-critical
}

assert {
  res.status: eq 200
  res.headers["x-database-node"]: eq PRIMARY
}
