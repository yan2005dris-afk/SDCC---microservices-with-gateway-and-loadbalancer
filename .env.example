# =============================================================================
# Variables de entorno para Docker Compose (compose.yaml)
# =============================================================================
# Uso:
#   cp .env.example .env      # luego cambia los valores
#   docker compose up -d --build
#
# Compose lee ".env" automáticamente. Si no existe, se usan los valores por
# defecto definidos en compose.yaml (iguales a los de este archivo).
# NO subas ".env" al repositorio: ya está ignorado en .gitignore.
# Los valores de abajo son ficticios y solo sirven para entornos locales.
# =============================================================================

# Superusuario de PostgreSQL. Lo usan el primario, las réplicas (heredado vía
# pg_basebackup, para su healthcheck) y los microservicios (DB_USER).
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_demo_change_me

# Base de datos inicial del clúster. Las bases de cada servicio (orders_db,
# inventory_db) se crean en docker/postgres/02-init-schemas.sql.
POSTGRES_DB=laboratorio

# Contraseña del rol "replicator" usado por pg_basebackup y el streaming WAL.
REPLICATION_PASSWORD=replica_demo_change_me

# Puertos publicados en el HOST (solo para conectarte desde tu máquina con psql,
# DBeaver, etc.). Dentro de la red de contenedores todos usan 5432.
# El primario usa 5435 por defecto para no chocar con un PostgreSQL local en 5432.
PG_PRIMARY_PORT=5435
PG_REPLICA1_PORT=5433
PG_REPLICA2_PORT=5434
