# Set default behavior to automatically normalize line endings (LF in repo)
* text=auto eol=lf

# Explicit text files that must always have LF line endings (crucial for Linux containers & WSL)
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.env text eol=lf
*.txt text eol=lf
Dockerfile* text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.jar binary
*.war binary
